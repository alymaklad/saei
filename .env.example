# ── LLM provider ───────────────────────────────────────────────────
# "ollama"  = local model, fully free, no API key, needs Ollama running locally
# "gemini"  = Google Gemini API free tier, needs GEMINI_API_KEY
# "groq"    = Groq API free tier (fast hosted inference), needs GROQ_API_KEY
# "openrouter" = ~400 models behind one key with cross-provider failover,
#             needs OPENROUTER_API_KEY. Its free tier is capped by REQUEST
#             COUNT, not tokens -- see OPENROUTER_MODEL below.
# "anthropic" = Claude models, paid per token, needs ANTHROPIC_API_KEY
# "openai"    = OpenAI models, paid per token, needs OPENAI_API_KEY
LLM_PROVIDER=ollama
# ~2.5GB, sized to co-reside in VRAM with qwen3-embedding:4b (also ~2.5GB)
# on a 6-8GB laptop GPU rather than the two swapping in and out.
#   ollama pull qwen3:4b
OLLAMA_MODEL=qwen3:4b
# Context window for the local chat model. Set explicitly because Ollama
# otherwise uses the model's own default (commonly 4096) and SILENTLY
# truncates longer prompts -- the CV-rewrite prompt carries a whole CV plus a
# whole job description. Raising this costs VRAM (KV cache scales with it).
OLLAMA_NUM_CTX=8192
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenRouter: https://openrouter.ai/keys
# Model ids ending in ":free" cost nothing but are capped by REQUEST COUNT,
# not tokens -- 20/minute, and 50/DAY on an unfunded account (1,000/day once
# you've bought $10 of credits). This agent spends ~2-3 calls per job that
# clears the match gate, so 50/day is only ~15-20 jobs. Paid ids have no
# request cap. Free ids change over time: https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ── Job search ─────────────────────────────────────────────────────
# Greenhouse/Lever public APIs need no key. SerpAPI free tier = 100 searches/month.
# GREENHOUSE_BOARD_TOKENS/LEVER_COMPANY_SLUGS below are optional -- the same
# boards can also be added from the dashboard's Search tab (paste the board's
# URL), which stores them in the DB instead of here. Both sources are merged.
SERPAPI_KEY=
GREENHOUSE_BOARD_TOKENS=stripe,airbnb
LEVER_COMPANY_SLUGS=netflix
# Ashby (jobs.ashbyhq.com/<slug>) and SmartRecruiters (jobs.smartrecruiters.com/<Company>)
# public boards -- also keyless, read the same way.
ASHBY_BOARD_SLUGS=
SMARTRECRUITERS_COMPANIES=
# LinkedIn logged-out job search, one sweep per location (Worldwide = remote only).
# Blank disables it. Requests are paced LINKEDIN_REQUEST_DELAY seconds apart.
LINKEDIN_LOCATIONS=
LINKEDIN_REQUEST_DELAY=2
# Remote boards (Himalayas, Remotive, Jobicy, Working Nomads) keep only jobs open
# worldwide or to one of these places. Blank keeps everything.
SEARCH_ELIGIBLE_LOCATIONS=
# Default job title/position to search for. Used by the Search tab's
# "Search now" button and by the scheduler's automatic 8am run.
SEARCH_POSITION_QUERY=
# Seniority filter -- one of: intern, entry, mid, senior, lead, manager.
# Leave blank for no filter (any level).
SEARCH_SENIORITY_LEVEL=
# Max raw results kept from each individual site/board per search. Blank = no limit.
SEARCH_MAX_RESULTS_PER_SITE=
# Max age in days for a job posting to be included. Blank = no limit.
SEARCH_MAX_AGE_DAYS=
# Internal -- do not set by hand. Flips to true automatically the first time
# the app seeds default job boards (Wuzzuf/Bayt) into the Search tab's site
# list, so they only ever get added once and don't reappear after you
# remove one.
SEARCH_DEFAULT_SITES_SEEDED=
# Job boards a fresh install adds to the Search tab by itself. Blank = none:
# they're all listed under Search -> Manage sources with an Add button.
# Keys: wellfound, simplyhired (worldwide), wuzzuf, tanqeeb (Egypt),
# bayt (Gulf/MENA), gulftalent (Gulf) -- e.g. wellfound,wuzzuf.
SEARCH_DEFAULT_BOARDS=

# ── Google Sheets watchlist (free, Google Cloud service account) ───
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/service_account.json

# ── Gmail (free: sends your applications and your reports) ─────────
# Connect it on the Settings page with "Sign in with Google". Sa'ei's shared
# Google app needs no setup; a client file of your own at
# GMAIL_CREDENTIALS_JSON is used instead if present.
GMAIL_CREDENTIALS_JSON=credentials/gmail_credentials.json
GMAIL_TOKEN_JSON=credentials/gmail_token.json
APPLICANT_NAME=
APPLICANT_EMAIL=
# The daily report (20:00) and weekly news (Mondays 09:00) are emailed here.
# Blank = your own Gmail address.
REPORT_EMAIL_TO=

# ── Whitelist: sources allowed to auto-submit, comma separated ─────
# Leave EMPTY until you've manually verified a board's submit flow.
# Example once verified: WHITELISTED_SOURCES=greenhouse:stripe,lever:netflix
WHITELISTED_SOURCES=

# ── Auto-Apply Behavior (also editable from the Settings page) ─────
# One of: off | any | whitelist
#   off       = never auto-submit, everything drafts for review.
#   any       = auto-submit regardless of source/whitelist. Real submission
#               is still limited to what auto_submit_greenhouse actually
#               implements (a Greenhouse-only stub today) -- this mode
#               mainly matters for what gets logged in DRY_RUN mode until
#               a real per-site submitter exists.
#   whitelist = only sources listed in WHITELISTED_SOURCES below auto-submit
#               (the original, still-recommended default).
AUTO_APPLY_MODE=whitelist
# When true, a rewritten CV whose re-scored ATS score clears FIT_THRESHOLD
# can proceed to the normal apply-path decision (auto-submit/draft) instead
# of always stopping to notify you. Defaults to false -- opt in deliberately.
AUTO_APPLY_ON_TAILORED_SCORE=false
# ATS score (0.0-1.0) below which a job's CV gets rewritten instead of going
# straight to the apply-path decision. Also editable from the Settings page.
FIT_THRESHOLD=0.7

# ── Job matching: expansion, embeddings, ranking ───────────────────
# (all also editable from the Settings page's "Job Matching" panel)
# Expands your Position into equivalent job titles via one LLM call, so a
# "Software Engineer" search also finds "Backend Developer" postings.
# Cached per Position. false = search the literal text you typed only.
SEARCH_QUERY_EXPANSION=true
QUERY_EXPANSION_MAX_ROLES=8
# Reuse a previously generated expansion for the same Position? Default false
# -- every run regenerates, so prompt edits / model swaps / temperature
# variation show up immediately. Worth turning on only if you move to a
# metered provider and don't want the daily scheduler re-asking.
QUERY_EXPANSION_CACHE=false
# How much of the CV goes into the expansion prompt. 0 = the whole CV.
# A cap was cutting real signal (a 6.3k-char CV lost 36%, including the
# project descriptions that say what the candidate actually builds).
QUERY_EXPANSION_CV_CHARS=0
# SerpAPI's free tier is 100 searches/MONTH and each expanded phrase is its
# own search -- only this many phrases are ever sent there. 0 = skip SerpAPI.
SERPAPI_EXPANSION_LIMIT=2
# Embeddings for CV<->job-description semantic matching. NOT tied to
# LLM_PROVIDER: Groq has no embeddings endpoint at all.
#   ollama = local, free forever. Needs `ollama pull nomic-embed-text` once.
#   gemini = hosted free tier, uses GEMINI_API_KEY.
EMBEDDING_PROVIDER=ollama
# qwen3-embedding:4b -- 2.5GB, 40K context, 100+ languages. Chosen over
# nomic-embed-text (8K context but English-centric, weak on the Arabic and
# mixed-language postings that Wuzzuf/Bayt/GulfTalent return) and over
# embeddinggemma:300m (multilingual but only 2K context -- measured job
# descriptions here already reach ~2.2k tokens).
#   ollama pull qwen3-embedding:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
# Qwen3-Embedding is trained to take a task instruction on the QUERY side
# only. The CV is the query here; job descriptions stay bare. Ignored for
# models not trained this way.
EMBEDDING_QUERY_INSTRUCTION=Given a candidate's CV, retrieve job postings that match their skills and experience
# text-embedding-004 was shut down 2026-01-14 (embedding-001 before it) and
# now returns 404. gemini-embedding-001 is the text-only replacement.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Texts per embedding request (Gemini caps a batch at 100). Chunking means a
# rate-limit retry only redoes one chunk instead of the whole set.
EMBEDDING_BATCH_SIZE=100
# How similar a job description must be to your CV for a job whose TITLE
# didn't match to still be considered. A starting estimate -- worth tuning.
CV_JOB_SIMILARITY_THRESHOLD=0.5
# Jobs scoring below this skip the per-job LLM pipeline entirely.
# 0 = gate OFF, every job found is processed (the safe default).
MATCH_SCORE_THRESHOLD=0.0
# How many TITLE-MISMATCHED jobs are carried forward per run for the semantic
# retriever to evaluate. Without this the semantic path can't rescue anything,
# since the title filter would already have dropped those jobs.
# Leave BLANK to use the provider-aware default: 90 on Gemini (whose free
# tier meters 100 embeddings per MINUTE, counted per job description), 400 on
# Ollama (local, unmetered -- the only cost is wall-clock time). Set a value
# here only to override that.
SEMANTIC_CANDIDATE_CAP=
# Hard ceiling on job descriptions embedded in one run, across BOTH the
# semantic rescue path and scoring the title-matched jobs. The cap above
# alone isn't enough -- together the two can exceed the quota even when each
# is individually under it. Jobs beyond the budget score neutral on the
# semantic factor only; nothing is dropped.
# Blank = provider-aware default (95 on Gemini, 500 on Ollama).
EMBEDDING_MAX_PER_RUN=

# ── Search debug reports ───────────────────────────────────────────
# Writes a multi-sheet .xlsx per search run tracing every stage: what the
# position expanded to, what each source returned before/after each filter,
# which jobs the token/semantic paths kept or dropped and why, every ranking
# factor's contribution, and what the match gate held back.
# Debug the SEARCH only: runs expansion -> retrieval -> semantic -> ranking
# -> match gate, writes the report, then stops. No ATS scoring, no CV
# rewriting, no apply decisions, nothing written to the database -- so
# consecutive runs see the same jobs and their reports are comparable.
# Costs ~1 LLM call plus embeddings, vs 2-4 LLM calls PER JOB.
SEARCH_ONLY_MODE=false

SEARCH_DEBUG_REPORTS=true
SEARCH_REPORT_DIR=data/search_reports
# Oldest reports beyond this are pruned. 0 = keep everything.
SEARCH_REPORT_KEEP=30

# ── Safety ───────────────────────────────────────────────────────
# When true, every "send email" / "submit application" action is logged, not executed.
# Leave true until you've watched a few runs; then set false to send for real.
DRY_RUN=true

# ── Storage ──────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/job_agent.db

# ── Hosting (only when it runs on a server) ──────────────────────
# deploy/gcp/startup-script.sh sets these on the VM by itself; listed here so
# you know what they are. Leave them as they are on your own computer.
#
# Dashboard login. Blank = no login (fine on your own machine, never on a
# server: the API holds your CV, your keys and your Gmail).
APP_USERNAME=saei
APP_PASSWORD=
# Other sites allowed to call the API. Blank = the local port-5500 server only.
CORS_ALLOW_ORIGINS=
# false on a server: Gmail can't open a browser there to sign in. Sign in on
# your own computer, then copy credentials/gmail_token.json to the server.
GMAIL_INTERACTIVE_AUTH=true
# The 08:00 search / 20:00 report / Monday news follow this timezone.
# Blank = the machine's clock (UTC on a cloud VM).
SCHEDULER_TIMEZONE=
# true = the API also runs the schedule, so one process does everything.
RUN_SCHEDULER_IN_API=false

# ── Weekly news digest ("The Sa'ei Weekly", Mondays 09:00) ─────────
# Topic. Blank = the professional title on your profile. Also in Settings.
NEWS_TOPIC=
# Reddit communities for "On the Boards", comma separated, e.g.
# MachineLearning,LocalLLaMA. Blank = a few picked from the topic.
NEWS_SUBREDDITS=
