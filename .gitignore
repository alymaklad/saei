.env
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# stray secret dumps -- never commit real API keys/tokens/certs, wherever
# they end up living in the tree
*api*key*
*.pem
*.key
*secret*
*token*.txt

# runtime data — never commit real DB, credentials, generated CVs, or the
# user's actual uploaded CV (personal data: name, contact info, history)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
credentials/*.json
cv_output/*.docx
cv_output/*.pdf
cv/current_cv.*
# Search debug reports contain real job titles/URLs and the CV embedding cache
# is derived from personal CV content -- both are local diagnostics, not source.
data/search_reports/
data/cv_embedding_cache.json
# Also derived from the CV / profile (personal data), and local backups of the DB.
data/cv_profile_cache.json
data/span_embedding_cache.json
data/soft_skills_cache.json
data/*.backup-*
data/*.wiped-rows-*
!data/.gitkeep
!credentials/.gitkeep
!cv_output/.gitkeep
!cv/.gitkeep
